[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/self_report_overlay.gd" id="1"]

[node name="SelfReportOverlay" type="CanvasLayer"]
script = ExtResource("1")

[node name="Panel" type="PanelContainer" parent="."]
offset_left = 20.0
offset_top = 40.0
offset_right = 520.0
offset_bottom = 920.0

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Quick Check-In"

[node name="SubtitleLabel" type="Label" parent="Panel/VBox"]
layout_mode = 2
autowrap_mode = 2
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.75, 0.75, 0.78, 1)
text = "Optional. Helps calibrate the load model against how it actually felt. Only saved if session logging is enabled in Settings."

[node name="HSeparator" type="HSeparator" parent="Panel/VBox"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Panel/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="DimensionsContainer" type="VBoxContainer" parent="Panel/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="HSeparator2" type="HSeparator" parent="Panel/VBox"]
layout_mode = 2

[node name="Actions" type="HBoxContainer" parent="Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="SkipButton" type="Button" parent="Panel/VBox/Actions"]
layout_mode = 2
